# Production Postgres. Leave unset locally: an embedded database (PGlite)
# runs automatically with data in ./.data/moiety.
DATABASE_URL=

# Shared secret for the daily scan cron: POST /api/scan with
# "Authorization: Bearer $SCAN_TOKEN".
SCAN_TOKEN=

# Enables the payer risk radar. Free key from
# https://developer.company-information.service.gov.uk
COMPANIES_HOUSE_API_KEY=

# Enables AI contract-PDF import. Without it, manual entry still works.
ANTHROPIC_API_KEY=
